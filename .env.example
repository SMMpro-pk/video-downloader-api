# ========================================================
# SMMPro Video Downloader API — Configuration Template
# Copy this file to .env and adjust values as needed.
# All values have production-ready defaults if left unset.
# ========================================================

# ----------------- Server & Network -----------------
# Port to listen on (Default: 3000)
PORT=3000

# Application environment (development | production)
NODE_ENV=production

# ----------------- Security & API Key -----------------
# Secret key for API authentication.
# - Leave blank or unset to auto-generate a secure key on startup in production.
# - In local development, leaving it unset disables authentication.
API_SECRET_KEY=

# Force auto-generation of API key even in custom environments
AUTO_GENERATE_API_KEY=true

# ----------------- Rate Limiting -----------------
# Maximum requests per 15-minute window per IP (Default: 100)
RATE_LIMIT_MAX=100

# ----------------- Concurrency & Queue -----------------
# Maximum simultaneous yt-dlp extractions to protect CPU & memory (Default: 3 or 5)
MAX_CONCURRENT=5

# ----------------- Caching -----------------
# Cache duration for video metadata in minutes (Default: 60)
CACHE_TTL_MINUTES=60

# Maximum entries stored in in-memory cache before eviction (Default: 500)
CACHE_MAX_SIZE=500

# ----------------- Video & Format Constraints -----------------
# Maximum allowed video length in seconds (Default: 7200 = 2 hours)
MAX_VIDEO_DURATION=7200

# Maximum downloadable file size in megabytes (Default: 500)
MAX_FILE_SIZE_MB=500

# Maximum video formats returned per extraction (Default: 10)
MAX_FORMATS=10

# Maximum redirects to follow when unwrapping short URLs (Default: 10)
MAX_REDIRECTS=10

# Timeout in milliseconds for each redirect hop (Default: 8000)
REDIRECT_TIMEOUT=8000

# ----------------- Proxies & Bypassing (Optional) -----------------
# HTTP/HTTPS proxy to route yt-dlp traffic through (e.g. http://user:pass@proxy.ip:port)
# Recommended if deploying on AWS/Vercel/DigitalOcean where platforms rate-limit datacenter IPs
# PROXY_URL=
# YTDLP_PROXY=

# Path to cookies file (Netscape format) for authenticated extraction (Instagram, YouTube)
# YTDLP_COOKIES_FILE=

# Custom User-Agent string for yt-dlp requests
# YTDLP_USER_AGENT=

# Extra platform domains in format: platform1:domain1.com,domain2.com;platform2:domain3.com
# EXTRA_DOMAINS=
